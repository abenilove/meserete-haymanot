#!/bin/sh
set -e
PRG="$0"
while [ -h "$PRG" ]
do
  ls -ld "$PRG"
  link=`expr "$PRG" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`"/"$link"
  fi
done
SAVED="`pwd`"
cd "`dirname "$PRG"`"
APP_HOME="`pwd -P`"
cd "$SAVED"
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
exec java -cp "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
